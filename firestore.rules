rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mohammedkaysoom4@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Subjects collection (Admin creates/updates, students read)
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Questions collection for automation bank
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Library items & files
    match /library_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student marketplace
    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // MedFur Question Discussions (students and admins can read/post)
    match /question_comments/{commentId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // MedFur Question Reports (students report, supervisors review/resolve)
    match /question_reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Student private question progress
    match /user_question_progress/{progressId} {
      allow read, write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
